# Copie este arquivo para .env e preencha com seus valores
DATABASE_URL="mysql://root:SUASENHA@localhost:3306/pedidos_db"
JWT_SECRET="coloque_aqui_uma_string_secreta_e_longa"
PORT=3333
# URL(s) do frontend autorizadas a acessar a API, separadas por vírgula.
# Em produção, defina com a URL da Vercel, ex: https://seu-app.vercel.app
# Se não definida, libera qualquer origem (uso recomendado apenas em desenvolvimento).
CORS_ORIGIN=http://localhost:3000

# Configuração de envio de e-mail (usado para enviar o resumo do pedido ao
# cliente e/ou à fábrica). Sem essas variáveis, o envio de e-mail fica desabilitado.
# Exemplo com Gmail: host smtp.gmail.com, porta 587, use uma "senha de app"
# (não a senha normal da conta) em SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM_NAME=Sistema de Pedidos
SMTP_FROM_EMAIL=seuemail@gmail.com
