# Copie este arquivo para .env e preencha com seus valores
DATABASE_URL="mysql://root:SUASENHA@localhost:3306/pedidos_db"
JWT_SECRET="coloque_aqui_uma_string_secreta_e_longa"
PORT=3333
# URL(s) do frontend autorizadas a acessar a API, separadas por vírgula.
# Em produção, defina com a URL da Vercel, ex: https://seu-app.vercel.app
# Se não definida, libera qualquer origem (uso recomendado apenas em desenvolvimento).
CORS_ORIGIN=http://localhost:3000

# Configuração de envio de e-mail (usado para enviar o resumo do pedido ao
# cliente e/ou à fábrica). Sem RESEND_API_KEY, o envio de e-mail fica desabilitado.
# Usa a API HTTPS do Resend (https://resend.com) em vez de SMTP, porque muitas
# plataformas de hospedagem (ex: Railway em planos gratuitos) bloqueiam portas
# SMTP de saída. Crie uma conta gratuita no Resend e gere uma API key em
# https://resend.com/api-keys.
RESEND_API_KEY=re_sua_api_key_aqui
MAIL_FROM_NAME=Sistema de Pedidos
# onboarding@resend.dev só entrega e-mails para o endereço da sua própria conta
# Resend (uso apenas para teste). Para enviar a clientes/fábricas reais, verifique
# um domínio próprio em Resend > Domains e use um endereço desse domínio aqui.
MAIL_FROM_EMAIL=onboarding@resend.dev
