# Copie este arquivo para .env e preencha com seus valores
DATABASE_URL="mysql://root:SUASENHA@localhost:3306/pedidos_db"
JWT_SECRET="coloque_aqui_uma_string_secreta_e_longa"
PORT=3333
# URL(s) do frontend autorizadas a acessar a API, separadas por vírgula.
# Em produção, defina com a URL da Vercel, ex: https://seu-app.vercel.app
# Se não definida, libera qualquer origem (uso recomendado apenas em desenvolvimento).
CORS_ORIGIN=http://localhost:3000

# Configuração de envio de e-mail (usado para enviar o resumo do pedido ao
# cliente e/ou à fábrica). Sem BREVO_API_KEY, o envio de e-mail fica desabilitado.
# Usa a API HTTPS do Brevo (https://www.brevo.com) em vez de SMTP, porque muitas
# plataformas de hospedagem (ex: Railway em planos gratuitos) bloqueiam portas
# SMTP de saída. Crie uma conta gratuita no Brevo (300 e-mails/dia, sem cartão),
# verifique um e-mail remetente em Settings > Senders, Domains & Dedicated IPs >
# Senders (não precisa de domínio próprio), e gere uma API key em
# Settings > API Keys > SMTP & API.
BREVO_API_KEY=xkeysib-sua_api_key_aqui
MAIL_FROM_NAME=Sistema de Pedidos
# Precisa ser exatamente o e-mail verificado como sender na conta Brevo.
MAIL_FROM_EMAIL=seuemail@gmail.com
