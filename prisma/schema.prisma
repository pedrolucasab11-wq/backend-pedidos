generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Seller {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  phone    String
  logo     String? @default("")
  password String 
  orders   Order[]
  factories Factory[]
  clients   Client[]
}

model Factory {
  id       Int      @id @default(autoincrement())
  logo     String?  @default("")
  active   Boolean  @default(true)

  sellerId Int?
  seller   Seller?  @relation(fields: [sellerId], references: [id])

  // Dados
  cnpj                String?
  name                String  // Nome Fantasia
  razaoSocial         String?
  inscricaoEstadual   String?

  // Contato
  phone    String  // Telefone comercial
  celular  String?
  email    String  // Email comercial

  // Endereço
  cep          String?
  estado       String?
  cidade       String?
  bairro       String?
  endereco     String?  @db.Text

  // Atividade econômica
  dataAbertura         DateTime?
  porte                String?
  atividadePrincipal   String?  @db.Text
  atividadeSecundaria  String?  @db.Text
  naturezaJuridica     String?

  orders   Order[]
  products Product[]

  // CNPJ único apenas dentro das fábricas de um mesmo vendedor, nunca globalmente.
  @@unique([sellerId, cnpj], name: "sellerId_cnpj")
}

model Client {
  id            Int    @id @default(autoincrement())
  companyName   String
  cnpj          String
  stateInscr    String
  email         String
  address       String
  phone         String
  active        Boolean @default(true)

  sellerId      Int?
  seller        Seller? @relation(fields: [sellerId], references: [id])

  orders        Order[]
}

model Product {
  id           Int       @id @default(autoincrement())
  name         String
  code         String
  type         String?
  observation  String?   @db.Text
  // Preço de referência opcional: o preço real de venda é sempre informado
  // no momento do pedido (OrderItem.unitPrice), pois pode variar por negociação.
  unitPrice    Float?
  orderItems   OrderItem[]

  factoryId    Int        
  factory      Factory    @relation(fields: [factoryId], references: [id])

  // Código único apenas dentro dos produtos de uma mesma fábrica.
  @@unique([factoryId, code], name: "factoryId_code")
}

model Order {
  id            Int         @id @default(autoincrement())
  sellerId      Int
  factoryId     Int
  clientId      Int
  createdAt     DateTime    @default(now())

  paymentMethod String      // Forma de pagamento (Pix, Boleto, Cartão, Dinheiro)
  // Prazo/parcelamento do pagamento em dias, quando aplicável (ex: boleto "30/60/90").
  // Texto livre porque o prazo do boleto varia caso a caso, não é uma lista fixa.
  paymentTerms  String?
  buyerName     String      // Nome do comprador
  buyerPhone    String?     // Telefone do comprador
  description   String?     // Descrição opcional
  orderNumber   String      // Número do pedido
  freightType   String?

  seller        Seller      @relation(fields: [sellerId], references: [id])
  factory       Factory     @relation(fields: [factoryId], references: [id])
  client        Client      @relation(fields: [clientId], references: [id])

  items         OrderItem[]
}


model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId      Int
  productId    Int
  type         String?
  observation  String?
  discount     String?
  quantity   Int
  // Preço unitário no momento em que o pedido foi feito. É "congelado" aqui
  // porque o preço do produto pode variar entre pedidos e não deve ser
  // recalculado retroativamente se o preço de referência do produto mudar.
  unitPrice    Float

  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
}
