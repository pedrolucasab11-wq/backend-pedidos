generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Seller {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  phone    String
  logo     String? @default("")
  password String 
  orders   Order[]
  factories Factory[]
  clients   Client[]
}

model Factory {
  id       Int      @id @default(autoincrement())
  logo     String?  @default("")
  active   Boolean  @default(true)

  sellerId Int?
  seller   Seller?  @relation(fields: [sellerId], references: [id])

  // Dados
  cnpj                String? @unique
  name                String  // Nome Fantasia
  razaoSocial         String?
  inscricaoEstadual   String?

  // Contato
  phone    String  // Telefone comercial
  celular  String?
  email    String  // Email comercial

  // Endereço
  cep          String?
  estado       String?
  cidade       String?
  bairro       String?
  endereco     String?

  // Atividade econômica
  dataAbertura         DateTime?
  porte                String?
  atividadePrincipal   String?
  atividadeSecundaria  String?
  naturezaJuridica     String?

  orders   Order[]
  products Product[]  
}

model Client {
  id            Int    @id @default(autoincrement())
  companyName   String
  cnpj          String
  stateInscr    String
  email         String
  address       String
  phone         String
  active        Boolean @default(true)

  sellerId      Int?
  seller        Seller? @relation(fields: [sellerId], references: [id])

  orders        Order[]
}

model Product {
  id           Int       @id @default(autoincrement())
  name         String
  code         String
  type         String?
  observation  String?
  unitPrice    Float
  orderItems   OrderItem[]

  factoryId    Int        
  factory      Factory    @relation(fields: [factoryId], references: [id])
}

model Order {
  id            Int         @id @default(autoincrement())
  sellerId      Int
  factoryId     Int
  clientId      Int
  createdAt     DateTime    @default(now())

  paymentMethod String      // Forma de pagamento
  buyerName     String      // Nome do comprador
  buyerPhone    String?     // Telefone do comprador
  description   String?     // Descrição opcional
  orderNumber   String      // Número do pedido
  freightType   String?

  seller        Seller      @relation(fields: [sellerId], references: [id])
  factory       Factory     @relation(fields: [factoryId], references: [id])
  client        Client      @relation(fields: [clientId], references: [id])

  items         OrderItem[]
}


model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId      Int
  productId    Int
  type         String?
  observation  String?
  discount     String?
  quantity   Int

  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
}
